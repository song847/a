@echo off
title 部署脚本
color 0A

echo ==============================================
echo         正在构建前端项目...
echo ==============================================
cd F:\song\song\frontend
npm run build

if %errorlevel% neq 0 (
    echo 构建失败！请检查前端代码。
    pause
    exit /b 1
)

echo ==============================================
echo         正在上传前端文件...
echo ==============================================
scp -r dist root@124.220.104.101:/var/www/song-app/frontend/

echo ==============================================
echo         正在上传后端文件...
echo ==============================================
scp -r ../backend root@124.220.104.101:/var/www/song-app/

echo ==============================================
echo         正在重启服务器服务...
echo ==============================================
ssh root@124.220.104.101 "pm2 restart song-app && systemctl reload nginx"

echo ==============================================
echo                  更新完成！
echo ==============================================
echo 请打开 https://springclo.cn 查看更新
pause